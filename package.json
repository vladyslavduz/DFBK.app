{
  "name": "dfbk-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "render:promo": "node scripts/render-promo.cjs",
    "test:publishing-ui": "node scripts/public-promo-share-smoke.cjs && node scripts/publishing-smoke.cjs && node scripts/private-project-result-smoke.cjs",
    "typecheck:frontend": "tsc -p tsconfig.publishing.json --noEmit",
    "preview": "vite preview",
    "test:local": "node --experimental-sqlite --test --test-concurrency=1",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wrangler": "^4.130.0"
  }
}
