{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dfbk-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-14",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dfbk-db",
      "database_id": "4e4395c7-9dc5-46f5-ba95-507b348dc307"
    }
  ]
}

"vars": {
  "EMAIL_FROM": "DFBK.app <noreply@dfbk.app>"
},
