{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dfbk-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-14",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dfbk-db",
      "database_id": "4e4395c7-9dc5-46f5-ba95-507b348dc307"
    }
  ],

  "vars": {
    "EMAIL_FROM": "DFBK.app <noreply@auth.dfbk.app>",
    "GOOGLE_CLIENT_ID": "1042544046802-b4ajqujncpjjba3o308n4v0ramlo8nif.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://dfbk.app/api/auth/google/callback"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
